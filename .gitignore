# Node / dashboard
node_modules/
dist/
dist-ssr/
*.local

# Env files (never commit real *secret* keys)
.env
.env.*
!.env.example
# Exception: the Supabase anon key is meant to be public (RLS-protected,
# not secret) -- committed so Vercel's git-integration build has it without
# needing a manual dashboard env var step. See dashboard/README.md.
!dashboard/.env.production

# Arduino / firmware build artifacts
firmware/**/build/
*.hex
*.bin

# Supabase local dev
supabase/.branches/
supabase/.temp/

# Editors / OS
.vscode/
.idea/
.DS_Store
*.log

